{
  "manifest_version": 1,
  "type": "device",
  "name": "Horaires des services publics",
  "description": {
    "en": "Opening hours of the public services of your town: open now, today's hours, next opening.",
    "fr": "Horaires des services publics de votre commune : ouvert maintenant, horaires du jour, réouverture.",
    "de": "Öffnungszeiten der Behörden deiner Gemeinde: jetzt geöffnet, heutige Zeiten, nächste Öffnung.",
    "es": "Horario de los servicios públicos de su municipio: abierto ahora, horario de hoy, reapertura."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-services-publics:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-services-publics/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "countries": ["FR"],
  "keywords": [
    "service public",
    "mairie",
    "horaires",
    "CAF",
    "CPAM",
    "France services",
    "préfecture",
    "Service-Public.fr",
    "open data"
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Type your commune and tick the services you care about, then save: they appear in the Discover tab. Hours come from the Service-Public.fr directory and are indicative: check with the service. No account, no key.",
        "fr": "Saisissez votre commune, cochez les services qui vous intéressent et enregistrez : ils apparaissent dans l'onglet Découverte. Les horaires viennent de l'annuaire de Service-Public.fr et sont indicatifs : vérifiez auprès du service. Sans compte ni clé.",
        "de": "Gib deine Gemeinde ein, kreuze die gewünschten Dienste an und speichere: sie erscheinen im Tab „Entdecken“. Die Zeiten stammen aus dem Verzeichnis von Service-Public.fr und sind unverbindlich: frag beim Dienst nach. Kein Konto, kein Schlüssel.",
        "es": "Escriba su municipio, marque los servicios que le interesan y guarde: aparecen en la pestaña Descubrir. El horario procede del directorio de Service-Public.fr y es orientativo: compruébelo con el servicio. Sin cuenta ni clave."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-services-publics/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide de configuration",
            "de": "Einrichtungsanleitung",
            "es": "Guía de configuración"
          }
        }
      ]
    },
    {
      "key": "communes",
      "type": "string",
      "required": true,
      "label": {
        "en": "Communes",
        "fr": "Communes",
        "de": "Gemeinden",
        "es": "Municipios"
      },
      "description": {
        "en": "INSEE codes or names, separated by commas (5 at most). The services standing there or covering them are offered.",
        "fr": "Codes INSEE ou noms, séparés par des virgules (5 au plus). Les services qui s'y trouvent ou qui les couvrent sont proposés.",
